@using FinalProject_E_Wallet.Models.ViewModels
@model LoginViewModel

@{
    ViewData["Title"] = "Login";

}

    <!-- Top Navigation -->
    <nav class="top-nav">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <img src="~/images/Bucash.png" alt="BuCash"
                 style="height:22px; margin-right:6px; vertical-align:middle;"
                 onerror="this.style.display='none'" />
            BuCash
        </a>
        <div class="nav-links">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Home" asp-action="Privacy">About Us</a>
            <a href="#">Help</a>
        </div>
    </nav>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" style="z-index:100;">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" style="z-index:100;">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <div class="login-page">

        <!-- Left: Brand Panel -->
        <div class="brand-panel">
            <div class="brand-logo-box">
                <img src="~/images/Bucash.png" alt="BuCash" />
            </div>
            <div class="brand-name">BuCash</div>
            <div class="brand-tagline">Every peso today shapes your tomorrow!</div>
        </div>

        <!-- Right: Login Form Panel -->
        <div class="form-panel">
            <div class="login-card">
                <h2>Welcome back</h2>
                <p class="subtitle">Please enter your details to access your account.</p>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email or Mobile Number</label>
                        <input asp-for="Email" class="form-control" placeholder="name@gmail.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        
                        <label asp-for="Password" class="form-label">Password</label>                      
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" id="passwordInput" />                                                  
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <!--
                    <div class="mb-3 form-check">
                        
                        <input type="checkbox" class="form-check-input" id="rememberMe" name="RememberMe" />
                        <label class="form-check-label remember-label" for="rememberMe">Remember for 30 days</label>
                        
                         <div class="float-right">
                            <a href="#" class="forgot-link">Forgot Password?</a>
                         </div>
                    </div>
                    -->
                    
                    
                    <button type="submit" class="btn-login">Login</button>
                </form>

                <p class="register-text">
                    Don't have an account? <a asp-controller="Account" asp-action="Register">Sign up for free</a>
                </p>
            </div>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
            function togglePassword() {
                var input = document.getElementById('passwordInput');
                input.type = input.type === 'password' ? 'text' : 'password';
            }
    </script>
