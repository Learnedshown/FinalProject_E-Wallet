@using FinalProject_E_Wallet.Models.ViewModels
@model LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - BuCash</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- Top Navigation -->
    <nav class="top-nav">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <img src="~/images/Bucash.png" alt="BuCash"
                 style="height:22px; margin-right:6px; vertical-align:middle;"
                 onerror="this.style.display='none'" />
            BuCash
        </a>
        <div class="nav-links">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Home" asp-action="Privacy">About Us</a>
            <a href="#">Help</a>
        </div>
    </nav>

    <div class="login-page">

        <!-- Left: Brand Panel -->
        <div class="brand-panel">
            <div class="brand-logo-box">
                <img src="~/images/Bucash.png" alt="BuCash" />
            </div>
            <div class="brand-name">BuCash</div>
            <div class="brand-tagline">Every peso today shapes your tomorrow!</div>
        </div>

        <!-- Right: Login Form Panel -->
        <div class="form-panel">
            <div class="login-card">
                <h2>Welcome back</h2>
                <p class="subtitle">Please enter your details to access your account.</p>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email or Mobile Number</label>
                        <input asp-for="Email" class="form-control" placeholder="name@gmail.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <div class="forgot-row">
                            <a href="#" class="forgot-link">Forgot Password?</a>
                        </div>
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="password-wrapper">
                            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" id="passwordInput" />
                            <button type="button" class="toggle-password" onclick="togglePassword()" title="Show/hide password">
                                <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z" />
                                    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="rememberMe" name="RememberMe" />
                        <label class="form-check-label remember-label" for="rememberMe">Remember for 30 days</label>
                    </div>

                    <button type="submit" class="btn-login">Login</button>
                </form>

                <p class="register-text">
                    Don't have an account? <a href="/Account/Register">Sign up for free</a>
                </p>
            </div>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
            function togglePassword() {
                var input = document.getElementById('passwordInput');
                input.type = input.type === 'password' ? 'text' : 'password';
            }
    </script>
</body>
</html>
