@{
    ViewData["Title"] = "Home";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BuCash - Home</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- Top Navigation -->
    <nav class="top-nav">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <img src="~/images/Bucash.png" alt="BuCash"
                 style="height:22px; margin-right:6px; vertical-align:middle;"
                 onerror="this.style.display='none'" />
            BuCash
        </a>
        <div class="nav-links">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Home" asp-action="Privacy">About Us</a>
            <a href="#">Help</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <div class="home-page">
        <div class="home-hero">

            <!-- Logo Box -->
            <div class="home-logo-box">
                <img src="~/images/Bucash.png" alt="BuCash Logo" />
            </div>

            <!-- Brand Name -->
            <h1 class="home-brand-name">BuCash</h1>
            <p class="home-tagline">Every peso today shapes your tomorrow!</p>

            <!-- CTA Buttons -->
            <div class="home-buttons">
                <a asp-controller="Account" asp-action="Register" class="btn-home-register">REGISTER</a>
                <a asp-controller="Account" asp-action="Login" class="btn-home-login">LOGIN</a>
            </div>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
