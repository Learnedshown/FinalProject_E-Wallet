@model EditProfileViewModel

<div class="ep-wrapper">
    <div class="ep-card">

        <!-- HEADER -->
        <div class="ep-header">
            <div class="ep-header-left">
                <a asp-controller="Wallet" asp-action="Dashboard" class="ep-back-btn" title="Back">
                    &#8592;
                </a>
                <div>
                    <p class="ep-title">Edit Profile</p>
                    <p class="ep-subtitle">Manage your personal information and security</p>
                </div>
            </div>
            <div class="ep-brand">BuCash</div>
        </div>

        <form asp-controller="Wallet" asp-action="EditProfile" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />

            <div class="ep-body">

                <!-- LEFT: AVATAR -->
                <div class="ep-avatar-col">
                    <div class="ep-avatar-wrap">
                        <img id="previewImage"
                             src="@(string.IsNullOrEmpty(Model.ProfilePicturePath) ? "/images/Bucash.png" : Model.ProfilePicturePath)"
                             alt="Profile" />
                        <label class="ep-avatar-edit" for="profileImageInput" title="Change photo">
                            <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path d="M13.586 3.586a2 2 0 112.828 2.828l-9.9 9.9-3.414.586.586-3.414 9.9-9.9z" />
                            </svg>
                        </label>
                    </div>
                    <input type="file"
                           id="profileImageInput"
                           name="profileImage"
                           class="ep-file-input"
                           accept="image/jpeg,image/gif,image/png"
                           onchange="previewFile(event)" />
                    <div class="ep-avatar-label">Profile Picture</div>
                    <div class="ep-avatar-hint">JPG, GIF or PNG. Max size 2MB</div>
                </div>

                <!-- RIGHT: FIELDS -->
                <div class="ep-form-col">

                    <!-- PERSONAL INFORMATION -->
                    <div class="ep-section-label">Personal Information</div>

                    <div class="ep-row">
                        <div class="ep-field">
                            <label>First Name</label>
                            <input asp-for="FirstName" placeholder="First Name" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="ep-field">
                            <label>Last Name</label>
                            <input asp-for="LastName" placeholder="Last Name" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="ep-field full">
                        <label>Middle Name</label>
                        <input asp-for="MiddleName" placeholder="Middle Name" />
                        <span asp-validation-for="MiddleName" class="text-danger"></span>
                    </div>

                    <hr class="ep-divider" />

                    <!-- CONTACT & SECURITY -->
                    <div class="ep-section-label">Contact &amp; Security</div>

                    <div class="ep-row">
                        <div class="ep-field">
                            <label>Email Address</label>
                            <input asp-for="Email" readonly placeholder="Email" />
                        </div>
                        <div class="ep-field">
                            <label>Phone Number</label>
                            <input asp-for="PhoneNumber" placeholder="Phone Number" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="ep-row">
                        <div class="ep-field">
                            <label>New Password</label>
                            <input asp-for="NewPassword" type="password" autocomplete="new-password" placeholder="••••••••" />
                        </div>
                        <div class="ep-field">
                            <label>Confirm Password</label>
                            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="••••••••" />
                        </div>
                    </div>

                    <!-- ACTIONS -->
                    <div class="ep-actions">
                        <a asp-controller="Wallet" asp-action="Dashboard" class="ep-discard">Discard Changes</a>
                        <button type="submit" class="ep-save">
                            Save Changes
                            <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                            </svg>
                        </button>
                    </div>

                </div>
            </div>
        </form>

    </div>
</div>

<script>
    function previewFile(event) {
        const reader = new FileReader();
        reader.onload = function () {
            document.getElementById("previewImage").src = reader.result;
        };
        reader.readAsDataURL(event.target.files[0]);
    }
</script>