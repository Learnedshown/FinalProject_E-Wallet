
@model User

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Welcome, @Model.FullName</h2>
    <a href="/Account/Logout" class="btn btn-outline-danger">Logout</a>
</div>


<div class="card p-3 mb-3 shadow-sm">
    <h4>Balance</h4>
    <h2 class="text-success">₱@Model.Balance</h2>
</div>

<div class="row">

    <!-- CASH IN -->
    <div class="col-md-6">
        <div class="card p-3 shadow-sm">
            <h5>Cash In</h5>
            <form asp-action="CashIn" method="post">
                <input name="amount" type="number" class="form-control mb-2" />
                <button class="btn btn-success w-100">Cash In</button>
            </form>
        </div>
    </div>

    <!-- SEND MONEY -->
    <div class="col-md-6">
        <div class="card p-3 shadow-sm">
            <h5>Send Money</h5>
            <form asp-action="Send" method="post">

                <input name="receiverEmail" placeholder="Receiver Email"
                       class="form-control mb-2" />

                <input name="amount" type="number" placeholder="Amount"
                       class="form-control mb-2" />

                <button class="btn btn-primary w-100">Send</button>
            </form>
        </div>
    </div>

</div>

<a href="/Wallet/History" class="btn btn-link mt-3">View Transactions</a>