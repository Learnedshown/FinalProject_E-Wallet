@model User



<div class="cashin-wrapper">
    <div class="cashin-card">

        <!-- Icon -->
        <div class="cashin-icon-wrap">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M21 18v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1h-9a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h9zm-9-2h10V8H12v8zm4-2.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z" />
            </svg>
        </div>

        <!-- Title -->
        <h2 class="cashin-title">Cash In</h2>
        <p class="cashin-subtitle">Add funds to your digital wallet instantly and securely.</p>

        <!-- Balance -->
        <div class="balance-card">
            <div class="balance-label">Current Balance</div>
            <div class="balance-amount">₱ @Model.Balance.ToString("N2")</div>
        </div>

        <!-- Quick Amounts -->
        <div class="quick-label">Quick Amounts</div>
        <div class="quick-amounts">
            <button type="button" class="quick-btn" onclick="setAmount(100, this)">₱ 100</button>
            <button type="button" class="quick-btn" onclick="setAmount(500, this)">₱ 500</button>
            <button type="button" class="quick-btn" onclick="setAmount(1000, this)">₱ 1000</button>
            <button type="button" class="quick-btn" onclick="setAmount(5000, this)">₱ 5000</button>
        </div>

        <!-- Form -->
        <form asp-action="CashIn" method="post">

            <label class="amount-label">Amount</label>
            <div class="amount-input-wrap">
                <span class="amount-currency">₱</span>
                <input id="amountInput"
                       name="amount"
                       type="number"
                       step="0.01"
                       min="1"
                       class="amount-input"
                       placeholder="Enter amount"
                       required />
            </div>

            <div class="action-btns">
                <a href="/Wallet/Dashboard" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-cashin">Cash In</button>
            </div>

        </form>


    </div>
</div>

<script>
    function setAmount(value, btn) {
        document.getElementById('amountInput').value = value;
        document.querySelectorAll('.quick-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
    }

    document.getElementById('amountInput').addEventListener('input', function () {
        document.querySelectorAll('.quick-btn').forEach(b => b.classList.remove('active'));
    });
</script>
