@model List<User>



<div class="send-page">
    <div class="send-card">

        <!-- HEADER -->
        <div class="send-header">
            <a asp-controller="Wallet" asp-action="Dashboard" class="send-back">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
            </a>
            <h2 class="send-title">Send Money</h2>
            <div style="width:32px;"></div>
        </div>

        <!-- SEARCH -->
        <div class="send-search-wrap">
            <svg class="send-search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
            <input type="text" id="searchUser" class="send-search" placeholder="Search user by name or email..." />
        </div>

        <!-- RECIPIENTS LABEL -->
        <div class="send-section-label">Recent Recipients</div>

        <!-- USER LIST -->
        <div id="userList" class="send-user-list">
            @foreach (var user in Model)
            {
                var initials = string.Join("", user.FullName
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Select(w => w[0].ToString().ToUpper()));
                var colors = new[] { "#2d6a4f", "#1e6091", "#6d4c41", "#4a4e69", "#5e548e", "#3a7ca5" };
                var colorIndex = Math.Abs(user.Email.GetHashCode()) % colors.Length;
                var avatarColor = colors[colorIndex];

                <div class="send-user-row"
                     data-name="@user.FullName.ToLower()"
                     data-email="@user.Email.ToLower()">
                    <div class="send-avatar" style="background:@avatarColor;">@initials</div>
                    <div class="send-user-info">
                        <div class="send-user-name">@user.FullName</div>
                        <div class="send-user-email">@user.Email</div>
                    </div>
                    <button class="send-select-btn" onclick="selectUser('@user.Email', '@user.FullName')">Select</button>
                </div>               
            }
           
        </div>

    </div>
</div>

<!-- SEND MODAL -->
<div class="modal fade" id="sendModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:20px; overflow:hidden;">
            <form asp-action="Send" method="post" onsubmit="this.querySelector('button[type=submit]').disabled=true;">
                <div class="modal-header border-0 pb-0 px-4 pt-4">
                    <h5 class="modal-title fw-bold">Send Money</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4 py-3">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Receiver</label>
                        <input id="receiverName" class="form-control" readonly style="border-radius:12px;" />
                    </div>
                    <input id="receiverEmail" name="receiverEmail" hidden />
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Amount</label>
                        <input id="amountInput" name="amount" type="number" step="0.01" class="form-control" required placeholder="₱ 0.00" style="border-radius:12px;" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold text-muted small">Quick Amounts</label>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-outline-success btn-sm quick-amount" data-amount="50" style="border-radius:20px;">₱50</button>
                            <button type="button" class="btn btn-outline-success btn-sm quick-amount" data-amount="100" style="border-radius:20px;">₱100</button>
                            <button type="button" class="btn btn-outline-success btn-sm quick-amount" data-amount="200" style="border-radius:20px;">₱200</button>
                            <button type="button" class="btn btn-outline-success btn-sm quick-amount" data-amount="500" style="border-radius:20px;">₱500</button>
                            <button type="button" class="btn btn-outline-success btn-sm quick-amount" data-amount="1000" style="border-radius:20px;">₱1000</button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="submit" class="btn w-100 fw-bold" style="background:#2d6a4f;color:#fff;border-radius:14px;padding:12px;">Send Money</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.getElementById("searchUser").addEventListener("keyup", function () {
        let value = this.value.toLowerCase();
        document.querySelectorAll(".send-user-row").forEach(row => {
            let show = row.dataset.name.includes(value) || row.dataset.email.includes(value);
            row.style.display = show ? "flex" : "none";
        });
    });

    function selectUser(email, name) {
        document.getElementById("receiverEmail").value = email;
        document.getElementById("receiverName").value = name;
        new bootstrap.Modal(document.getElementById('sendModal')).show();
    }

    document.querySelectorAll(".quick-amount").forEach(btn => {
        btn.addEventListener("click", function () {
            document.getElementById("amountInput").value = this.dataset.amount;
        });
    });
</script>
